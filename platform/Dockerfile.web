# Multi-stage Dockerfile for Next.js Dashboard & On-Demand Scanner
# Stage 1: Build the Go scanner CLI binary with Tree-sitter CGO
FROM golang:1.23-bookworm AS scanner-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libc-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY go.work go.work.sum* ./
COPY engine/go.mod engine/go.sum* ./engine/
COPY platform/go.mod platform/go.sum* ./platform/

WORKDIR /app/engine
RUN go mod download

WORKDIR /app
COPY engine/ ./engine/
COPY platform/ ./platform/
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /bin/lucid-scan ./engine/cmd/scan/main.go

# Stage 2: Build Next.js Dashboard
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Install dependencies based on package-lock.json
COPY platform/web/package.json platform/web/package-lock.json ./
RUN npm ci

# Copy source tree
COPY platform/web/ ./

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build the Next.js application
RUN npm run build

# Stage 3: Production runner image
FROM node:20-bookworm-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Install production dependencies only
COPY platform/web/package.json platform/web/package-lock.json ./
RUN npm ci --omit=dev

# Copy build artifacts and configuration
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.mjs ./next.config.mjs
COPY --from=scanner-builder /bin/lucid-scan /usr/local/bin/lucid-scan

EXPOSE 3000

CMD ["npm", "start"]
