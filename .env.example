# ============================================================================
# LUCID-CI — Monorepo Environment Configuration Template
# Region-locked deployment target: ap-southeast-2 (Asia Pacific - Sydney)
# ============================================================================

# Database (PostgreSQL)
DATABASE_URL=postgres://lucid:lucid_dev@localhost:5432/lucid_ci?sslmode=disable

# AWS Configuration (Locked to ap-southeast-2 for this AWS account)
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_PROFILE=lucid

# SQS Configuration
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/lucid-ci-scans

# AI Microservice Configuration
AI_SERVICE_URL=http://localhost:8000
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub App Configuration (Phase 4 Live Integration)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
