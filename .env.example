# ============================================================================
# LUCID-CI — Monorepo Environment Configuration Template
# Region-locked deployment target: ap-southeast-2 (Asia Pacific - Sydney)
# ============================================================================

# Database (PostgreSQL)
DATABASE_URL=postgres://lucid:lucid_dev@localhost:5432/lucid_ci?sslmode=disable

# AWS Configuration (Locked to ap-southeast-2 for this AWS account)
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_PROFILE=lucid

# SQS Configuration
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/lucid-ci-scans

# AI Microservice Configuration
AI_SERVICE_URL=http://localhost:8000
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=vertexai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Cloud Vertex AI Configuration (Gemini 3.5 Flash-Lite)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_MODEL=gemini-3.5-flash-lite
GOOGLE_APPLICATION_CREDENTIALS=/etc/lucid/gcp-credentials.json
GCP_CONFIG_DIR=/var/lib/lucid/config
GCP_CREDENTIALS_PATH=/var/lib/lucid/config/gcp-credentials.json

# Backwards-compatibility aliases
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# GitHub App Configuration (Phase 4 Live Integration)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Dynamic Sandbox Detonation Configuration
SANDBOX_RUNTIME=runsc
SANDBOX_ALLOW_RUNTIME_FALLBACK=true

